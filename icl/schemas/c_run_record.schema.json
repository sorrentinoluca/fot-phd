{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Condition C inference run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "condition",
    "physical_case_id",
    "repetition",
    "sequence_index",
    "parsed_output",
    "valid",
    "prompt_sha256",
    "raw_attempts",
    "retry_count",
    "model_requested",
    "model_returned",
    "reasoning_effort",
    "timestamp_iso",
    "openai_sdk_version",
    "stateless",
    "network_retries"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "const": "central"
    },
    "condition": {
      "type": "string",
      "const": "C"
    },
    "physical_case_id": {
      "type": "string",
      "pattern": "^PBH-\\d{3}$"
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "sequence_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 44
    },
    "parsed_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicted_label",
        "abstain",
        "used_insight_ids",
        "reasoning_summary"
      ],
      "properties": {
        "predicted_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "abstain": {
          "type": "boolean"
        },
        "used_insight_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasoning_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "valid": {
      "type": "boolean"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_index",
          "raw_response",
          "parse_success",
          "error_type",
          "request_id",
          "response_id",
          "token_usage"
        ],
        "properties": {
          "attempt_index": {
            "type": "integer",
            "minimum": 0
          },
          "raw_response": {
            "type": "string"
          },
          "parse_success": {
            "type": "boolean"
          },
          "error_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "network",
              "parse",
              "schema",
              null
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "response_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "token_usage": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "prompt_tokens",
                  "completion_tokens",
                  "total_tokens"
                ],
                "properties": {
                  "prompt_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "completion_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total_tokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "model_requested": {
      "type": "string",
      "minLength": 1
    },
    "model_returned": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "timestamp_iso": {
      "type": "string",
      "format": "date-time"
    },
    "openai_sdk_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version string of the openai SDK used for inference (R7 P1-2)"
    },
    "stateless": {
      "type": "boolean",
      "const": true
    },
    "network_retries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt",
          "error_type",
          "error_message",
          "backoff_seconds",
          "timestamp_iso"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "error_type": {
            "type": "string",
            "minLength": 1
          },
          "error_message": {
            "type": "string"
          },
          "backoff_seconds": {
            "type": "number",
            "minimum": 0
          },
          "timestamp_iso": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Per-retry provenance for transient network-level retries before the successful call"
    }
  }
}
