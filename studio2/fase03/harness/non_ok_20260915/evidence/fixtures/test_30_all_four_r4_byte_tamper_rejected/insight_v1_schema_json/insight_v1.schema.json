{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study 2 insight v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "insight_id",
    "source_agent",
    "pseudolabel",
    "evidence_scope",
    "variable_ids",
    "observed_pattern"
  ],
  "properties": {
    "insight_id": {
      "type": "string",
      "pattern": "^S2-INS-[0-9]{3}$",
      "maxLength": 10
    },
    "source_agent": {
      "type": "string",
      "pattern": "^agent_[1-8]$",
      "maxLength": 7
    },
    "pseudolabel": {
      "type": "string",
      "pattern": "^S2-CLS-[A-Z0-9]{5}$",
      "maxLength": 12
    },
    "evidence_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "variable_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^X(?:MEAS\\((?:[1-9]|[1-3][0-9]|4[01])\\)|MV\\((?:[1-9]|1[0-2])\\))(?![\\s\\S])"
      }
    },
    "observed_pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800,
      "pattern": "\\S"
    }
  },
  "$id": "urn:fot-tep:studio2:insight:1.0.0"
}

