{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXP3_V2 durable inference request journal entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "sequence_index",
    "attempt",
    "job_key",
    "timestamp",
    "base_prompt_hash",
    "prompt_hash",
    "input_hash",
    "requested_model",
    "request_parameters",
    "response"
  ],
  "properties": {
    "record_type": {"enum": ["request_intent", "provider_response"]},
    "sequence_index": {"type": "integer", "minimum": 0, "maximum": 1079},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "job_key": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "base_prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_model": {"const": "gpt-5.6-terra"},
    "request_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning_effort",
        "max_output_tokens",
        "store",
        "temperature_sent",
        "seed_sent",
        "previous_response_id_used"
      ],
      "properties": {
        "reasoning_effort": {"const": "medium"},
        "max_output_tokens": {"const": 512},
        "store": {"const": false},
        "temperature_sent": {"const": false},
        "seed_sent": {"const": false},
        "previous_response_id_used": {"const": false}
      }
    },
    "response": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "raw_output",
        "requested_model",
        "returned_model",
        "response_id",
        "request_id",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "sdk_version",
        "api_family",
        "endpoint",
        "usage_raw",
        "response_raw"
      ],
      "properties": {
        "raw_output": {"type": "string"},
        "requested_model": {"const": "gpt-5.6-terra"},
        "returned_model": {"const": "gpt-5.6-terra"},
        "response_id": {"type": ["string", "null"]},
        "request_id": {"type": ["string", "null"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "sdk_version": {"const": "3.6.0"},
        "api_family": {"const": "Responses API"},
        "endpoint": {"const": "/v1/responses"},
        "usage_raw": {"type": ["object", "null"]},
        "response_raw": {"type": "object"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "request_intent"}}},
      "then": {"properties": {"response": {"type": "null"}}},
      "else": {"properties": {"response": {"type": "object"}}}
    }
  ]
}
