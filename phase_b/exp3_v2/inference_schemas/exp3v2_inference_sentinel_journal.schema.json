{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXP3_V2 inference API sentinel durable journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "sentinel_id",
    "timestamp",
    "prompt_sha256",
    "requested_model",
    "request_parameters",
    "provider_submission_count",
    "response"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"enum": ["sentinel_request_intent", "sentinel_provider_receipt"]},
    "sentinel_id": {"const": "EXP3V2-INFERENCE-SENTINEL-001"},
    "timestamp": {"type": "string", "minLength": 1},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_model": {"const": "gpt-5.6-terra"},
    "request_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning_effort",
        "max_output_tokens",
        "store",
        "temperature_sent",
        "seed_sent",
        "previous_response_id_used",
        "sdk_automatic_retries"
      ],
      "properties": {
        "reasoning_effort": {"const": "medium"},
        "max_output_tokens": {"const": 512},
        "store": {"const": false},
        "temperature_sent": {"const": false},
        "seed_sent": {"const": false},
        "previous_response_id_used": {"const": false},
        "sdk_automatic_retries": {"const": 0}
      }
    },
    "provider_submission_count": {"const": 1},
    "response": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "api_family",
            "endpoint",
            "input_tokens",
            "output_tokens",
            "raw_output",
            "request_id",
            "requested_model",
            "response_id",
            "response_raw",
            "returned_model",
            "sdk_version",
            "total_tokens",
            "usage_raw"
          ],
          "properties": {
            "api_family": {"const": "Responses API"},
            "endpoint": {"const": "/v1/responses"},
            "input_tokens": {},
            "output_tokens": {},
            "raw_output": {"type": "string"},
            "request_id": {"type": ["string", "null"]},
            "requested_model": {"const": "gpt-5.6-terra"},
            "response_id": {"type": ["string", "null"]},
            "response_raw": {"type": "object"},
            "returned_model": {"type": "string"},
            "sdk_version": {"type": "string", "minLength": 1},
            "total_tokens": {},
            "usage_raw": {"type": ["object", "null"]}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "sentinel_request_intent"}}},
      "then": {"properties": {"response": {"type": "null"}}},
      "else": {"properties": {"response": {"type": "object"}}}
    }
  ]
}
