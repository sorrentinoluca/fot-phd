{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXP3_V2 inference API sentinel evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sentinel_id",
    "status",
    "completed_at",
    "provider_submission_count",
    "intent_sha256",
    "receipt_sha256",
    "prompt_sha256",
    "requested_model",
    "returned_model",
    "request_parameters",
    "http_success",
    "strict_schema_pass",
    "synthetic_label_pass",
    "token_accounting_pass",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "parsed_output",
    "failure_reason",
    "scientific_input_used",
    "scientific_output_created"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sentinel_id": {"const": "EXP3V2-INFERENCE-SENTINEL-001"},
    "status": {"enum": ["PASS", "FAIL"]},
    "completed_at": {"type": "string", "minLength": 1},
    "provider_submission_count": {"const": 1},
    "intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_model": {"const": "gpt-5.6-terra"},
    "returned_model": {"type": "string"},
    "request_parameters": {"$ref": "#/$defs/requestParameters"},
    "http_success": {"type": "boolean"},
    "strict_schema_pass": {"type": "boolean"},
    "synthetic_label_pass": {"type": "boolean"},
    "token_accounting_pass": {"type": "boolean"},
    "input_tokens": {},
    "output_tokens": {},
    "total_tokens": {},
    "parsed_output": {"type": ["object", "null"]},
    "failure_reason": {"type": ["string", "null"]},
    "scientific_input_used": {"const": false},
    "scientific_output_created": {"const": false}
  },
  "$defs": {
    "requestParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning_effort",
        "max_output_tokens",
        "store",
        "temperature_sent",
        "seed_sent",
        "previous_response_id_used",
        "sdk_automatic_retries"
      ],
      "properties": {
        "reasoning_effort": {"const": "medium"},
        "max_output_tokens": {"const": 512},
        "store": {"const": false},
        "temperature_sent": {"const": false},
        "seed_sent": {"const": false},
        "previous_response_id_used": {"const": false},
        "sdk_automatic_retries": {"const": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {
        "properties": {
          "returned_model": {"const": "gpt-5.6-terra"},
          "http_success": {"const": true},
          "strict_schema_pass": {"const": true},
          "synthetic_label_pass": {"const": true},
          "token_accounting_pass": {"const": true},
          "input_tokens": {"type": "integer", "minimum": 0},
          "output_tokens": {"type": "integer", "minimum": 0},
          "total_tokens": {"type": "integer", "minimum": 0},
          "parsed_output": {"type": "object"},
          "failure_reason": {"type": "null"}
        }
      },
      "else": {"properties": {"failure_reason": {"type": "string", "minLength": 1}}}
    }
  ]
}
