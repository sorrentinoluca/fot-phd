{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXP3_V2 validated inference repetition record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence_index", "block_index", "position_in_block", "physical_case_id",
    "agent_id", "condition", "repetition", "requested_model", "returned_model",
    "reasoning_effort", "temperature", "seed", "max_output_tokens",
    "structured_outputs_strict", "max_structural_retries", "prompt_hash",
    "input_hash", "prompt_character_count", "available_insight_ids",
    "provider_attempts", "raw_attempts", "raw_output", "parsed_final_output",
    "parse_failure", "structural_validation_errors", "input_tokens",
    "output_tokens", "total_tokens", "cumulative_input_tokens",
    "cumulative_output_tokens", "cumulative_total_tokens", "retry_count",
    "timestamp", "stateless", "store", "previous_response_id_used"
  ],
  "properties": {
    "sequence_index": {"type": "integer", "minimum": 0, "maximum": 1079},
    "block_index": {"type": "integer", "minimum": 0, "maximum": 359},
    "position_in_block": {"type": "integer", "minimum": 1, "maximum": 3},
    "physical_case_id": {"type": "string", "pattern": "^EXP3V2-(N|F1|F8|F10|F13)-00[1-6]$"},
    "agent_id": {"type": "string", "pattern": "^agent_[1-4]$"},
    "condition": {"enum": ["A", "B", "E"]},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
    "requested_model": {"const": "gpt-5.6-terra"},
    "returned_model": {"const": "gpt-5.6-terra"},
    "reasoning_effort": {"const": "medium"},
    "temperature": {"type": "null"},
    "seed": {"type": "null"},
    "max_output_tokens": {"const": 512},
    "structured_outputs_strict": {"const": true},
    "max_structural_retries": {"const": 2},
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_character_count": {"type": "integer", "minimum": 1},
    "available_insight_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provider_attempts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object"}},
    "raw_attempts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
    "raw_output": {"type": "string"},
    "parsed_final_output": {"$ref": "../../../conditions/diagnostic_output.schema.json"},
    "parse_failure": {"type": "boolean"},
    "structural_validation_errors": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "cumulative_input_tokens": {"type": "integer", "minimum": 0},
    "cumulative_output_tokens": {"type": "integer", "minimum": 0},
    "cumulative_total_tokens": {"type": "integer", "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "timestamp": {"type": "string", "format": "date-time"},
    "stateless": {"const": true},
    "store": {"const": false},
    "previous_response_id_used": {"const": false}
  }
}
