{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXP3_V2 minimal confirmatory results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "analysis_population", "prediction_source",
    "aggregate_records_total", "primary_agent_case_rows_per_condition",
    "secondary_agent_case_rows_per_condition",
    "physical_fault_clusters", "condition_metrics", "contrasts",
    "success_criteria", "abstention_treatment", "multiplicity_adjustment",
    "optional_analyses_included", "input_aggregate_sha256", "bootstrap_artifact"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "CONFIRMATORY_EVALUATION_COMPLETE_PENDING_RESULTS_FREEZE"},
    "analysis_population": {"const": "EXP3_V2_MINIMAL_CONFIRMATORY_PRIMARY_AND_DESCRIPTIVE_POPULATIONS"},
    "prediction_source": {"const": "FROZEN_R3_AGGREGATES_ONLY"},
    "aggregate_records_total": {"const": 360},
    "primary_agent_case_rows_per_condition": {"const": 72},
    "secondary_agent_case_rows_per_condition": {
      "const": {"local_seen": 24, "normal": 24, "overall": 120}
    },
    "physical_fault_clusters": {"const": 24},
    "condition_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["A", "B", "E"],
      "properties": {"A": {"$ref": "#/$defs/conditionMetrics"}, "B": {"$ref": "#/$defs/conditionMetrics"}, "E": {"$ref": "#/$defs/conditionMetrics"}}
    },
    "contrasts": {
      "type": "object", "additionalProperties": false,
      "required": ["B_minus_A", "B_minus_E"],
      "properties": {"B_minus_A": {"type": "number"}, "B_minus_E": {"type": "number"}}
    },
    "success_criteria": {
      "type": "object", "additionalProperties": false,
      "required": ["replication_supported", "requires_observed_B_minus_A_gt_0", "requires_B_minus_A_ci_lower_gt_0", "semantic_specificity_supported", "semantic_specificity_ci_is_not_a_gate"],
      "properties": {
        "replication_supported": {"type": "boolean"},
        "requires_observed_B_minus_A_gt_0": {"const": true},
        "requires_B_minus_A_ci_lower_gt_0": {"const": true},
        "semantic_specificity_supported": {"type": "boolean"},
        "semantic_specificity_ci_is_not_a_gate": {"const": true}
      }
    },
    "abstention_treatment": {"const": "incorrect"},
    "multiplicity_adjustment": {"const": "none_single_primary_contrast"},
    "optional_analyses_included": {"const": []},
    "input_aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bootstrap_artifact": {"const": "exp3v2_confirmatory_bootstrap.json"}
  },
  "$defs": {
    "conditionMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["unseen", "local_seen", "normal", "overall"],
      "properties": {
        "unseen": {"$ref": "#/$defs/metric72"},
        "local_seen": {"$ref": "#/$defs/metric24"},
        "normal": {"$ref": "#/$defs/metric24"},
        "overall": {"$ref": "#/$defs/metric120"}
      }
    },
    "metricBase": {
      "type": "object", "additionalProperties": false,
      "required": ["n", "correct", "incorrect", "abstentions", "accuracy"],
      "properties": {
        "n": {"type": "integer"},
        "correct": {"type": "integer", "minimum": 0},
        "incorrect": {"type": "integer", "minimum": 0},
        "abstentions": {"type": "integer", "minimum": 0},
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "metric72": {
      "allOf": [
        {"$ref": "#/$defs/metricBase"},
        {"properties": {"n": {"const": 72}, "correct": {"maximum": 72}, "incorrect": {"maximum": 72}, "abstentions": {"maximum": 72}}}
      ]
    },
    "metric24": {
      "allOf": [
        {"$ref": "#/$defs/metricBase"},
        {"properties": {"n": {"const": 24}, "correct": {"maximum": 24}, "incorrect": {"maximum": 24}, "abstentions": {"maximum": 24}}}
      ]
    },
    "metric120": {
      "allOf": [
        {"$ref": "#/$defs/metricBase"},
        {"properties": {"n": {"const": 120}, "correct": {"maximum": 120}, "incorrect": {"maximum": 120}, "abstentions": {"maximum": 120}}}
      ]
    }
  }
}
