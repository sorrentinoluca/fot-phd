{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXP3_V2 confirmatory evaluation output hash manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "artifact_count", "artifacts", "inventory_sha256", "optional_analyses_included"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "COMPLETE_PENDING_RESULTS_FREEZE"},
    "artifact_count": {"const": 2},
    "artifacts": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"enum": ["exp3v2_confirmatory_bootstrap.json", "exp3v2_confirmatory_results.json"]},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_analyses_included": {"const": []}
  }
}
