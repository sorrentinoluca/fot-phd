{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase B protocol configuration",
  "type": "object",
  "required": [
    "protocol_version",
    "status",
    "label_space",
    "agents",
    "local_examples",
    "insights",
    "conditions",
    "execution",
    "metrics",
    "data_boundaries"
  ],
  "properties": {
    "label_space": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true},
    "agents": {"type": "object", "minProperties": 4, "maxProperties": 4},
    "conditions": {"const": ["A", "B", "E"]},
    "execution": {
      "type": "object",
      "required": ["model", "model_version", "tokenizer", "repetitions", "temperature", "seed", "max_retries"],
      "properties": {
        "model": {"type": ["string", "null"]},
        "model_version": {"type": ["string", "null"]},
        "tokenizer": {"type": ["string", "null"]},
        "repetitions": {"const": 3},
        "temperature": {"const": 0.0},
        "seed": {"type": "integer"},
        "max_retries": {"const": 2}
      }
    }
  }
}
