{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase B protocol configuration",
  "type": "object",
  "required": [
    "protocol_version",
    "status",
    "label_space",
    "agents",
    "local_examples",
    "insights",
    "conditions",
    "execution",
    "metrics",
    "data_boundaries"
  ],
  "properties": {
    "label_space": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true},
    "agents": {"type": "object", "minProperties": 4, "maxProperties": 4},
    "conditions": {"const": ["A", "B", "E"]},
    "execution": {
      "type": "object",
      "required": ["provider", "api_family", "requested_model", "returned_model", "model", "model_version", "sdk_version", "reasoning_effort", "tokenizer", "token_accounting_source", "capability_probe_status", "repetitions", "temperature", "seed", "max_retries"],
      "properties": {
        "provider": {"const": "openai"},
        "api_family": {"const": "Responses API"},
        "requested_model": {"const": "gpt-5.6-terra"},
        "returned_model": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "model_version": {"type": ["string", "null"]},
        "sdk_version": {"type": ["string", "null"]},
        "reasoning_effort": {"enum": ["medium", null]},
        "tokenizer": {"type": ["string", "null"]},
        "token_accounting_source": {"type": ["string", "null"]},
        "capability_probe_status": {"enum": ["NOT_RUN", "COMPLETE", "BLOCKED"]},
        "repetitions": {"const": 3},
        "temperature": {"type": ["number", "null"]},
        "seed": {"type": ["integer", "null"]},
        "max_retries": {"const": 2}
      }
    }
  }
}
