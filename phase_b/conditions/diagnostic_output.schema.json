{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase B diagnostic output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicted_label",
    "abstain",
    "used_insight_ids",
    "reasoning_summary"
  ],
  "properties": {
    "predicted_label": {"type": ["string", "null"]},
    "abstain": {"type": "boolean"},
    "used_insight_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "reasoning_summary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"abstain": {"const": true}}},
      "then": {"properties": {"predicted_label": {"type": "null"}}},
      "else": {"properties": {"predicted_label": {"type": "string", "minLength": 1}}}
    }
  ]
}
